` Draws the addon's icons into model_railroading.icons (beside addon.toml): a 16 × 16 and a 32 × 32
` icon for each kind it adds, which the Leah IDE shows in its library and tray. A pack is a zip file:
` `<kind>-16.png` and `<kind>-32.png` for each kind, and `index.json` naming them, as Leah's own addons'
` packs are (design/icons.md). Run it with a Leah that has windows' drawing and archives (the graphics
` and compression addons), after adding or changing an icon:
`
`     leah tools/make_icons.leah [a preview sheet to write, a .png]

include "icon_helpers.leah"

$icons = []
` A base station: a box, its DCC square wave on its face, and two rails below.
$icons["dcc_base"] = function() {
    ic.rbox(0.5, 1.5, 15, 9, ic.face, ic.edge)
    ic.stroke([[2.5, 7.5], [4.5, 7.5], [4.5, 4], [6.5, 4], [6.5, 7.5], [9.5, 7.5], [9.5, 4], [11.5, 4], [11.5, 7.5], [13.5, 7.5]], ic.accent, 1.2)
    ic.fill(0, 12.5, 16, 1, ic.edge)
    ic.fill(0, 14.5, 16, 1, ic.edge)
}
` A locomotive: its boiler, cab, and wheels, on a rail.
$icons["locomotive"] = function() {
    ic.rfill(1, 6, 9, 5, ic.accent, 1)
    ic.rfill(9, 3, 6, 8, ic.accent_dark, 1)
    ic.fill(10.5, 4.5, 3, 2.5, ic.accent_light)
    ic.fill(3, 3.5, 2, 2.5, ic.ink)
    ic.circle(2, 10, 4, 4, ic.ink)
    ic.circle(6.5, 10, 4, 4, ic.ink)
    ic.circle(11, 10, 4, 4, ic.ink)
    ic.fill(0, 14.5, 16, 1, ic.edge)
}
` A program being loaded onto a board: a chip with its pins, and an arrow coming down into it.
$icons["dcc_program_job"] = function() {
    foreach [4.5, 7.5, 10.5] as $x {
        ic.fill($x, 6.5, 1, 1.5, ic.edge)
        ic.fill($x, 14.5, 1, 1.5, ic.edge)
    }
    ic.rbox(2.5, 8, 11, 6.5, ic.face, ic.edge, 1)
    ic.fill(7, 0, 2, 4, ic.green)
    ic.shape([[4, 3.5], [12, 3.5], [8, 7.5]], ic.green)
}
` A decoder definition: a sheet of settings, each row a name and its bits.
$icons["decoder_definition"] = function() {
    ic.rbox(2, 0.5, 12, 15, ic.face, ic.edge, 1)
    foreach [3, 7, 11] as $y {
        ic.fill(4, $y, 4, 1.5, ic.mid)
        ic.fill(9.5, $y, 1, 1.5, ic.accent)
        ic.fill(11, $y, 1, 1.5, ic.accent_light)
    }
}
` A decoder programmer: a decoder chip with its pins, a setting read up out of it and one written down.
$icons["decoder_programmer"] = function() {
    foreach [2, 5] as $x {
        ic.fill($x, 3.5, 1, 1.5, ic.edge)
        ic.fill($x, 12, 1, 1.5, ic.edge)
    }
    ic.rbox(0.5, 5, 7.5, 7, ic.mid, ic.ink, 1)
    ic.fill(9.75, 4, 1.5, 9, ic.green)
    ic.shape([[8.5, 4.5], [12.5, 4.5], [10.5, 1]], ic.green)
    ic.fill(13, 3, 1.5, 9, ic.accent)
    ic.shape([[11.75, 11.5], [15.75, 11.5], [13.75, 15]], ic.accent)
}
` A roster entry: a card with a locomotive on it and two lines of its record.
$icons["roster_entry"] = function() {
    ic.rbox(0.5, 2.5, 15, 11, ic.face, ic.edge, 1)
    ic.rfill(2.5, 6, 5, 3, ic.accent, 0.5)
    ic.rfill(6.5, 4.5, 2.5, 4.5, ic.accent_dark, 0.5)
    ic.fill(2.5, 10, 6.5, 1, ic.ink)
    ic.fill(10.5, 5, 3.5, 1.5, ic.mid)
    ic.fill(10.5, 8, 3.5, 1.5, ic.mid)
}
` A roster: a stack of cards, the front one with a locomotive.
$icons["roster"] = function() {
    ic.rbox(3.5, 0.5, 12, 9, ic.soft, ic.edge, 1)
    ic.rbox(2, 2.5, 12, 9, ic.soft, ic.edge, 1)
    ic.rbox(0.5, 4.5, 12, 11, ic.face, ic.edge, 1)
    ic.rfill(2.5, 8.5, 4.5, 3, ic.accent, 0.5)
    ic.rfill(6, 7, 2.5, 4.5, ic.accent_dark, 0.5)
    ic.fill(2.5, 12.5, 6, 1, ic.ink)
    ic.fill(9.5, 8.5, 1.5, 1.5, ic.mid)
}
` A consist: two locomotives coupled back to back on one rail.
$icons["consist"] = function() {
    ic.rfill(0.5, 6, 6.5, 5, ic.accent, 1)
    ic.rfill(0.5, 3.5, 3, 7.5, ic.accent_dark, 1)
    ic.rfill(9, 6, 6.5, 5, ic.accent, 1)
    ic.rfill(12.5, 3.5, 3, 7.5, ic.accent_dark, 1)
    ic.fill(7, 8.5, 2, 1, ic.ink)
    foreach [1.5, 4.5, 10, 13] as $x {
        ic.circle($x, 11, 2.5, 2.5, ic.ink)
    }
    ic.fill(0, 14.5, 16, 1, ic.edge)
}
` A phone throttle server: a phone with a speed slider on its screen, and the Wi-Fi's waves beside it.
$icons["phone_throttle_server"] = function() {
    ic.rbox(0.5, 1, 8.5, 14.5, ic.face, ic.edge, 1.5)
    ic.fill(2, 3, 5.5, 9.5, ic.soft)
    ic.fill(4.25, 4, 1, 7.5, ic.mid)
    ic.rfill(3, 6.5, 3.5, 1.5, ic.accent, 0.5)
    ic.fill(3.75, 13.5, 2, 1, ic.edge)
    ic.arc(10, 8, 2.5, -50, 50, ic.green, 1.2)
    ic.arc(10, 8, 5, -50, 50, ic.green, 1.2)
}
` A turnout: the straight route and the diverging one leaving it, the points at the split.
$icons["turnout"] = function() {
    ic.stroke([[1, 13], [15, 13]], ic.edge, 2)
    ic.stroke([[5, 13], [10, 9], [15, 4]], ic.accent, 2)
    ic.fill(4, 11.5, 2.5, 3, ic.green)
}
` A sensor: a detector box beside a rail, its lamp lit.
$icons["sensor"] = function() {
    ic.rbox(3, 2, 10, 8, ic.face, ic.edge, 1.5)
    ic.circle(6, 4, 4, 4, ic.green)
    ic.fill(7.5, 10, 1, 2.5, ic.edge)
    ic.fill(0, 12.5, 16, 1, ic.edge)
    ic.fill(0, 14.5, 16, 1, ic.edge)
}
` A light: a lamp post, its lamp glowing.
$icons["light"] = function() {
    ic.circle(3.5, 0, 9, 9, "#FCEBB0")
    ic.circle(5.5, 2, 5, 5, ic.yellow, ic.orange)
    ic.fill(7.25, 7, 1.5, 7, ic.edge)
    ic.fill(5, 14, 6, 1.5, ic.ink)
}
` A block: a stretch of rail between two joints, lit as occupied.
$icons["block"] = function() {
    ic.fill(0, 6.5, 16, 1, ic.edge)
    ic.fill(0, 9.5, 16, 1, ic.edge)
    ic.fill(3.5, 5.5, 9, 6, ic.accent)
    ic.fill(3.5, 6.5, 9, 1, ic.accent_dark)
    ic.fill(3.5, 9.5, 9, 1, ic.accent_dark)
    ic.fill(2.5, 4, 1, 9, ic.ink)
    ic.fill(12.5, 4, 1, 9, ic.ink)
}
` A layout: a small track plan, an oval loop with a siding leaving it, a train on the loop.
$icons["layout"] = function() {
    ic.turned_outline(0, 0, 0, 14, 10, 4.5, ic.edge, 1.5)
    ic.stroke([[4, 12.5], [8, 9.5], [12, 9.5]], ic.edge, 1.5)
    ic.rfill(5, 1.5, 6, 3, ic.accent, 1)
}
` A route: a yard ladder, one track lit its way.
$icons["route"] = function() {
    ic.stroke([[0.5, 13.5], [15.5, 13.5]], ic.edge, 1.5)
    ic.stroke([[3, 13.5], [8, 8.5], [15.5, 8.5]], ic.edge, 1.5)
    ic.stroke([[8, 8.5], [13, 3.5], [15.5, 3.5]], ic.accent, 2)
    ic.stroke([[0.5, 13.5], [3, 13.5], [8, 8.5]], ic.accent, 2)
}
` A track plan: blocks as dots, joined by track, one split at a turnout.
$icons["track_plan"] = function() {
    ic.stroke([[2.5, 12.5], [7.5, 12.5], [13.5, 12.5]], ic.edge, 1.5)
    ic.stroke([[7.5, 12.5], [13.5, 4.5]], ic.edge, 1.5)
    ic.circle(0.5, 10.5, 4, 4, ic.accent)
    ic.circle(5.5, 10.5, 4, 4, ic.green)
    ic.circle(11.5, 10.5, 4, 4, ic.accent)
    ic.circle(11.5, 2.5, 4, 4, ic.accent)
}
` A track diagram: a dark panel with a siding, the main line lit occupied.
$icons["track_diagram"] = function() {
    ic.rbox(0.5, 2, 15, 12, "#2B2F36", ic.ink, 1.5)
    ic.stroke([[2, 10], [14, 10]], ic.mid, 1.5)
    ic.stroke([[4, 10], [6, 6], [10, 6], [12, 10]], ic.mid, 1.5)
    ic.stroke([[6, 10], [10, 10]], ic.red, 1.5)
}
` A fast clock: a clock face, its hands, and a little arrow of speed.
$icons["fast_clock"] = function() {
    ic.circle(1, 1, 14, 14, ic.face, ic.edge)
    ic.stroke([[8, 8], [8, 3.5]], ic.ink, 1.5)
    ic.stroke([[8, 8], [11.5, 9.5]], ic.ink, 1.5)
    ic.shape([[11, 1], [15.5, 1], [15.5, 5.5]], ic.orange)
}
` A layout simulator: a loop of track, a train on its near straight, and a play mark inside.
$icons["layout_simulator"] = function() {
    ic.turned_outline(0, 0, 1.5, 15, 9, 4.5, ic.edge, 1.5)
    ic.rfill(3.5, 10.5, 7, 3.5, ic.purple, 1)
    ic.shape([[6.5, 3.5], [10.5, 6], [6.5, 8.5]], ic.green)
}
` An auto train: a locomotive with an arrow ahead of it, running by itself.
$icons["auto_train"] = function() {
    ic.rfill(0.5, 6, 7, 5, ic.accent, 1)
    ic.rfill(6, 3.5, 4, 7.5, ic.accent_dark, 1)
    ic.circle(1.5, 10, 3.5, 3.5, ic.ink)
    ic.circle(6, 10, 3.5, 3.5, ic.ink)
    ic.shape([[11, 3], [15.5, 7], [11, 11]], ic.green)
    ic.fill(0, 14.5, 16, 1, ic.edge)
}
` A speedometer: a dial with its needle well over.
$icons["speedometer"] = function() {
    ic.arc(8, 10, 6.5, 180, 360, ic.edge, 2)
    ic.stroke([[8, 10], [12.5, 5]], ic.red, 1.5)
    ic.circle(6.5, 8.5, 3, 3, ic.ink)
    ic.fill(1, 12.5, 14, 1.5, ic.edge)
}
` A switchboard: a grid of buttons, two of them lit.
$icons["switchboard"] = function() {
    foreach [[1, 2], [6, 2], [11, 2], [1, 9], [6, 9], [11, 9]] as $i: $p {
        ic.fill($p[0], $p[1], 4, 5, if $i == 0 or $i == 4 then ic.green else ic.edge)
    }
}

$sizes = [16, 32]
` (One date for every entry, so the pack only changes when an icon does.)
$stamp = make_date(2026, 10, 26)
$path = join_path(file_path(script_path()), "..", "model_railroading.icons")
$index = ["format": 1, "name": "the model_railroading addon", "sizes": $sizes, "icons": []]
$pack = new_archive(kind: "zip")
$made = []
foreach $icons as $kind: $draw {
    $index["icons"][$kind] = []
    foreach $sizes as $size {
        $p = ic.begin($size)
        $draw()
        $name = $kind + "-" + $size + ".png"
        $pack.add_data(picture_to_bytes($p), $name, modified: $stamp)
        $index["icons"][$kind][to_text($size)] = $name
        $made[] = [$kind, $size, $p]
    }
}
$pack.add_data(json_encode($index, pretty: true) + "\n", "index.json", modified: $stamp)
write_bytes_file($path, $pack.finish())
print("make_icons: " + count($icons) + " icons in " + tidy_path($path) + " (" + format_file_size(file_size($path)) + ")")

` A preview sheet, for looking at them: each icon at 32 × 32, at 16 × 16, and at 16 × 16 made four
` times bigger, on a light and a dark ground.
$args = command_line_arguments()
if count($args) > 0 {
    $sheet = picture(width: 250, height: count($icons) * 152, background: "#FFFFFF")
    $sg = $sheet.graphics
    $sg.picture_smoothing = "none"
    $sg.font_size = 11
    $i = 0
    foreach $icons as $kind: $draw {
        foreach [["#F4F5F7", "#20242B", 0], ["#2A2C31", "#E8EAEE", 1]] as [$ground, $text, $dark] {
            $y = ($i * 2 + $dark) * 76
            $sg.drawing_color = $ground
            $sg.fill_rectangle(0, $y, 250, 76)
            $big = first_match($made, fn($m) => $m[0] == $kind and $m[1] == 32)[2]
            $small = first_match($made, fn($m) => $m[0] == $kind and $m[1] == 16)[2]
            $sg.draw_picture($big, 6, $y + 6)
            $sg.draw_picture($small, 46, $y + 14)
            $sg.draw_picture($small, 70, $y + 6, 64, 64)
            $sg.drawing_color = $text
            $sg.draw_text($kind, 140, $y + 40)
        }
        $i++
    }
    save_picture($sheet, $args[0], overwrite: true)
    print("make_icons: the preview, " + $args[0])
}
