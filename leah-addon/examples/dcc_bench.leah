$win.add($reader_port)

$refresh = button(left: 536, top: 44, width: 140, text: "Look again")
$win.add($refresh)
$load = button(left: 536, top: 80, width: 140, text: "Load programs")
$win.add($load)
$connect = button(left: 690, top: 44, width: 136, height: 64, text: "Connect", lock_left: false, lock_right: true)
$win.add($connect)

$status = label(left: 36, top: 118, width: 640, height: 56, text: "", multi_line: true, lock_right: true)
$win.add($status)
` (Shown when Linux doesn't let this account use the boards yet.)
$give_access = button(left: 690, top: 122, width: 136, height: 44, text: "Give access", lock_left: false, lock_right: true, visible: false)
$win.add($give_access)

